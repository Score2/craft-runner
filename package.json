{
  "name": "@score2/craft-runner",
  "version": "1.0.2",
  "description": "Local Minecraft server plugin testing platform exposed as an MCP server.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Score2/craft-runner.git"
  },
  "bin": {
    "craft-runner-mcp": "dist/bin/mcp.js",
    "craft-runner": "dist/bin/cli.js",
    "craftr": "dist/bin/cli.js"
  },
  "files": [
    "agent/build.gradle.kts",
    "agent/build/libs/*.jar",
    "agent/settings.gradle.kts",
    "agent/*/build.gradle.kts",
    "agent/common/src",
    "agent/platform-bukkit/src",
    "agent/platform-bungee/src",
    "agent/platform-fabric/src",
    "agent/platform-forge/src",
    "agent/platform-forge-legacy/src",
    "agent/platform-forge-modern/src",
    "agent/platform-neoforge/src",
    "agent/platform-neoforge-legacy/src",
    "agent/platform-neoforge-modern/src",
    "agent/platform-velocity/src",
    "dist/bin",
    "dist/bridge",
    "dist/core",
    "dist/debug",
    "dist/server",
    "dist/java",
    "dist/lib",
    "dist/mcp",
    "dist/remote",
    "dist/storage",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:agent",
    "build:ts": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"const fs=require('fs'); for (const f of ['dist/bin/mcp.js','dist/bin/cli.js']) fs.chmodSync(f, 0o755)\"",
    "build:agent": "node -e \"require('fs').rmSync('agent/build/libs',{recursive:true,force:true})\" && gradle -p agent jar",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/bin/mcp.js",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3"
  }
}
