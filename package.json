{
  "name": "@score2/craft-runner",
  "version": "0.1.0",
  "description": "Local Minecraft server plugin testing platform exposed as an MCP server.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "craft-runner-mcp": "./dist/bin/mcp.js",
    "craft-runner": "./dist/bin/cli.js",
    "craftr": "./dist/bin/cli.js"
  },
  "files": [
    "dist/bin",
    "dist/core",
    "dist/env",
    "dist/java",
    "dist/lib",
    "dist/mcp",
    "dist/storage",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs'); for (const f of ['dist/bin/mcp.js','dist/bin/cli.js']) fs.chmodSync(f, 0o755)\"",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/bin/mcp.js",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3"
  }
}
